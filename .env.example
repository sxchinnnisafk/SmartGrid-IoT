# ==============================================================================
# SmartGrid AIoT — AI Chatbot & Voice Dispatch Environment Template
# ==============================================================================
# Copy this file to `.env` (or add these keys in Vercel Project Settings -> Environment Variables).

# 1. Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenRouter fallback (only used if GEMINI_API_KEY is left unset)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# 2. ElevenLabs Text-to-Speech API (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
