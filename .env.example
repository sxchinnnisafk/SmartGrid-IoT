# ==============================================================================
# Celestia Rover — Surveillance, AI & Supabase Environment Template
# ==============================================================================
# Copy this file to `.env` (or add these keys in Vercel Project Settings -> Environment Variables).

# 1. Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Latest default (2026): gemini-3.8-flash
# Alternatives: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview
GEMINI_MODEL=gemini-3.8-flash

# Optional: OpenRouter fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# 2. ElevenLabs Text-to-Speech API (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Default free premade voice: George (JBFqnCBsd6RMkjVDRZzb — ElevenLabs official Quickstart default)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# 3. Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
